{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "LongMarch: refresh Ninja compile commands",
      "type": "process",
      "command": "cmake",
      "args": ["-S", "${workspaceFolder}", "-B", "${workspaceFolder}/cmake-build-ninja", "-G", "Ninja", "-DCMAKE_EXPORT_COMPILE_COMMANDS=ON"],
      "problemMatcher": []
    },
    {
      "label": "LongMarch: build Sparkium Ninja",
      "type": "process",
      "command": "cmake",
      "args": ["--build", "${workspaceFolder}/cmake-build-ninja", "--target", "demo_sparkium_cli", "demo_sparkium_gui", "sparkium_fallback_test", "-j", "8"],
      "dependsOn": "LongMarch: refresh Ninja compile commands",
      "group": {"kind": "build", "isDefault": true},
      "problemMatcher": "$gcc"
    }
  ]
}
