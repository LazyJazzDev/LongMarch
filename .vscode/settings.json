{
  "clangd.path": "clangd",
  "clangd.arguments": [
    "--background-index",
    "--compile-commands-dir=${workspaceFolder}/cmake-build-ninja"
  ],
  "cmake.generator": "Ninja",
  "cmake.buildDirectory": "${workspaceFolder}/cmake-build-ninja",
  "cmake.configureOnOpen": false,
  "cmake.configureSettings": {
    "CMAKE_EXPORT_COMPILE_COMMANDS": true
  }
}
