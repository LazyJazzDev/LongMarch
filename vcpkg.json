{
  "name": "longmarch",
  "version-string": "0.0.1",
  "description": "A C++ library for graphics study",
  "dependencies": [
    "eigen3",
    "glm",
    "glfw3",
    "fmt",
    "freetype",
    "vulkan-memory-allocator",
    "gtest",
    "stb",
    "mikktspace",
    "tinyobjloader",
    "tinyfiledialogs",
    "rapidjson",
    "assimp",
    {
      "name": "d3dx12",
      "platform": "windows"
    }
  ],
  "features": {
    "wayland": {
      "description": "Build native Wayland support alongside X11 on Linux",
      "supports": "linux",
      "dependencies": [
        {
          "name": "glfw3",
          "features": ["wayland"]
        }
      ]
    }
  }
}
